CREATE TABLE `worklog` (
  `id` INTEGER PRIMARY KEY AUTOINCREMENT,
  `start` INTEGER NOT NULL DEFAULT 0,
  `end` INTEGER NOT NULL DEFAULT 0,
  `duration` INTEGER NOT NULL DEFAULT 0,
  `code` TEXT DEFAULT '' NOT NULL,
  `comment` TEXT DEFAULT '' NOT NULL,
  `system_note` TEXT DEFAULT '' NOT NULL,
  `author` TEXT DEFAULT '' NOT NULL,
  `remote_id` INTEGER NOT NULL DEFAULT -1,
  `is_deleted` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  `is_dirty` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  `is_error` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  `error_message` TEXT NOT NULL DEFAULT '',
  `fetchTime` INTEGER NOT NULL DEFAULT 0,
  `URL` TEXT NOT NULL DEFAULT ''
);

selectByStartRange:
SELECT *
FROM worklog
WHERE `start` >= :fromMillis AND `start` <= :toMillis;

selectById:
SELECT *
FROM worklog
WHERE id = ?;

selectByRemoteId:
SELECT *
FROM worklog
WHERE remote_id = ?;

countById:
SELECT COUNT(*)
FROM worklog
WHERE id = ?;

countByRemoteId:
SELECT COUNT(*)
FROM worklog
WHERE remote_id = ?;

insert:
INSERT INTO worklog(
  `start`,
  `end`,
  `duration`,
  `code`,
  `comment`,
  `system_note`,
  `author`,
  `remote_id`,
  `is_deleted`,
  `is_dirty`,
  `is_error`,
  `error_message`,
  `fetchTime`,
  `URL`
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

update:
UPDATE worklog
SET `start` = :start,
  `end` = :end,
  `duration` = :duration,
  `code` = :code,
  `comment` = :comment,
  `system_note` = :system_note,
  `author` = :author,
  `remote_id` = :remote_id,
  `is_deleted` = :is_deleted,
  `is_dirty` = :is_dirty,
  `is_error` = :is_error,
  `error_message` = :error_message,
  `fetchTime` = :fetchTime,
  `URL` = :URL
WHERE id = :id;

deleteById:
DELETE FROM worklog
WHERE id = ?;

deleteByRemoteId:
DELETE FROM worklog
WHERE remote_id = ?;
