CREATE TABLE `ticket` (
  `id` INTEGER PRIMARY KEY AUTOINCREMENT,
  `code_project` TEXT DEFAULT '' NOT NULL,
  `code_number` TEXT DEFAULT '' NOT NULL,
  `code` TEXT DEFAULT '' NOT NULL,
  `description` TEXT DEFAULT '' NOT NULL,
  `parent_id` INTEGER NOT NULL DEFAULT -1,
  `remote_id` INTEGER NOT NULL DEFAULT -1,
  `is_deleted` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  `is_dirty` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  `is_error` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
  `error_message` TEXT NOT NULL DEFAULT '',
  `fetchTime` INTEGER NOT NULL DEFAULT 0,
  `URL` TEXT NOT NULL DEFAULT '',
  `parent_code` TEXT DEFAULT '' NOT NULL,
  `status` TEXT DEFAULT '' NOT NULL,
  `assignee` TEXT DEFAULT '' NOT NULL,
  `reporter` TEXT DEFAULT '' NOT NULL,
  `is_watching` INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0
);

selectAll:
SELECT *
FROM ticket;

selectByCode:
SELECT *
FROM ticket
WHERE code = ?;

countByRemoteId:
SELECT COUNT(*)
FROM ticket
WHERE remote_id = ?;

insert:
INSERT INTO ticket(
  `code`,
  `code_project`,
  `code_number`,
  `description`,
  `parent_id`,
  `remote_id`,
  `is_deleted`,
  `is_dirty`,
  `is_error`,
  `error_message`,
  `fetchTime`,
  `URL`,
  `status`,
  `assignee`,
  `reporter`,
  `is_watching`,
  `parent_code`
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateByRemoteId:
UPDATE ticket
SET `code` = :code,
  `code_project` = :code_project,
  `code_number` = :code_number,
  `description` = :description,
  `parent_id` = :parent_id,
  `is_deleted` = :is_deleted,
  `is_dirty` = :is_dirty,
  `is_error` = :is_error,
  `error_message` = :error_message,
  `fetchTime` = :fetchTime,
  `URL` = :URL,
  `status` = :status,
  `assignee` = :assignee,
  `reporter` = :reporter,
  `is_watching` = :is_watching,
  `parent_code` = :parent_code
WHERE remote_id = :remote_id;

rowsChanged:
SELECT changes();
